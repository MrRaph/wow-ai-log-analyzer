# =====================================================================
# WoW AI Log Analyzer — environment configuration
# Copy to .env and adjust values. Docker Compose reads this file.
# =====================================================================

# --- General ---
APP_NAME=WoW AI Log Analyzer
APP_ENV=production            # production | development
LOG_LEVEL=INFO
TZ=Europe/Berlin

# Public base URL of the frontend (used in emails, OAuth callbacks, CORS).
PUBLIC_BASE_URL=http://localhost:3000

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# IMPORTANT: generate a long random string, e.g. `openssl rand -hex 64`
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30
# Comma-separated origins allowed to call the API (frontend URLs).
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=wowanalyzer
POSTGRES_USER=wowanalyzer
POSTGRES_PASSWORD=change-me

# --- Redis (cache + arq queue) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Warcraft Logs API v2 ---
# Create a client at https://www.warcraftlogs.com/api/clients/ (Public Client).
# Pick any name + redirect URL (e.g. http://localhost). Copy id + secret here.
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
WCL_API_URL=https://www.warcraftlogs.com/api/v2/client
WCL_OAUTH_TOKEN_URL=https://www.warcraftlogs.com/oauth/token

# --- AI provider (Anthropic Claude) ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Default model for analyses; admins can override per-request later.
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=8000

# --- SMTP (local relay, no auth/TLS) ---
SMTP_HOST=smtp.local
SMTP_PORT=25
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=wowanalyzer@example.com
SMTP_FROM_NAME=WoW AI Log Analyzer

# --- Top-Logs daily fetcher ---
# Cron expression for the daily refresh (UTC).
TOP_LOGS_CRON=0 4 * * *
# How many top entries to keep per class/spec/encounter.
TOP_LOGS_LIMIT=25

# --- Initial admin (created on first start if missing) ---
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=changeme-at-first-login

# --- Feature flags ---
ALLOW_REGISTRATION=true       # admins can flip this in the UI later

# --- Frontend (Next.js) ---
# Browser-visible API base URL. Use the host:port reachable from the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_LOCALE=en
