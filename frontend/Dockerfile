FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

FROM node:22-alpine AS builder
WORKDIR /app
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_DEFAULT_LOCALE
ARG NEXT_PUBLIC_IMPRINT_NAME
ARG NEXT_PUBLIC_IMPRINT_STREET
ARG NEXT_PUBLIC_IMPRINT_POSTAL_CITY
ARG NEXT_PUBLIC_IMPRINT_COUNTRY
ARG NEXT_PUBLIC_IMPRINT_EMAIL
ARG NEXT_PUBLIC_IMPRINT_PHONE
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_DEFAULT_LOCALE=${NEXT_PUBLIC_DEFAULT_LOCALE}
ENV NEXT_PUBLIC_IMPRINT_NAME=${NEXT_PUBLIC_IMPRINT_NAME}
ENV NEXT_PUBLIC_IMPRINT_STREET=${NEXT_PUBLIC_IMPRINT_STREET}
ENV NEXT_PUBLIC_IMPRINT_POSTAL_CITY=${NEXT_PUBLIC_IMPRINT_POSTAL_CITY}
ENV NEXT_PUBLIC_IMPRINT_COUNTRY=${NEXT_PUBLIC_IMPRINT_COUNTRY}
ENV NEXT_PUBLIC_IMPRINT_EMAIL=${NEXT_PUBLIC_IMPRINT_EMAIL}
ENV NEXT_PUBLIC_IMPRINT_PHONE=${NEXT_PUBLIC_IMPRINT_PHONE}
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
USER nextjs
EXPOSE 3000
ENV PORT=3000 HOSTNAME=0.0.0.0
CMD ["node", "server.js"]
